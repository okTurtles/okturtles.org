---
import JobPost from '../../layouts/JobPost.astro'
import { getAllJobs } from '@/utils.js'

export async function getStaticPaths() {
  const jobs = getAllJobs()
  return jobs.map((job: any) => {
    const filePath = job.file || ''
    const fileName = filePath.split('/').pop() || ''
    const isDisabled = fileName.startsWith('_')
    return {
      params: { job: job.frontmatter.permalink },
      props: { ...job, isDisabled }
    }
  })
}

const { Content, isDisabled } = Astro.props
---
{isDisabled ? (
  <html>
    <head>
      <meta http-equiv="refresh" content="0;url=/hiring" />
    </head>
    <body></body>
  </html>
) : (
  <>
    <JobPost>
      <article class="job-content">
        <Content />
      </article>
    </JobPost>

    <script>
      document.addEventListener("DOMContentLoaded", function () {
        window.scrollTo({
            top: 500,
            behavior: "smooth"
        })
      })
    </script>
  </>
)}
